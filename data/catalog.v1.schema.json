                              "min": {
                                "type": "number"
                              },
                              "optimum": {
                                "type": "number"
                              },
                              "max": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "min",
                              "optimum",
                              "max"
                            ],
                            "additionalProperties": false
                          },
                          "limits": {
                            "type": "object",
                            "properties": {
                              "minElevationM": {
                                "type": "number",
                                "minimum": -2000,
                                "maximum": 20000
                              },
                              "maxElevationM": {
                                "type": "number",
                                "minimum": -2000,
                                "maximum": 20000
                              },
                              "maxSlopeDegrees": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 90
                              }
