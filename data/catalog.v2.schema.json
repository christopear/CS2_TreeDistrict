                    "maximum": 20000
                  },
                  "maxElevationM": {
                    "type": "number",
                    "minimum": -10000,
                    "maximum": 20000
                  },
                  "maxSlopeDegrees": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 90
                  }
                },
                "required": [
                  "minElevationM",
                  "maxElevationM",
                  "maxSlopeDegrees"
