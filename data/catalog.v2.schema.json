                "maximum": 200
              },
              "spacingAdjustmentM": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "heightM": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 200
              },
              "canopyRadiusM": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "canopyOpacityPercent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "shadeTolerancePercent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
