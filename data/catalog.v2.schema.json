      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "game",
            "manual"
          ]
        },
        "referenceTemperatureC": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "referenceElevationM": {
          "type": "number",
          "minimum": -2000,
          "maximum": 20000
        },
        "coolingCPerKm": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        }
      },
      "required": [
        "source",
        "referenceTemperatureC",
        "referenceElevationM",
        "coolingCPerKm"
      ],
      "additionalProperties": false
    },
    "assets": {
      "minItems": 1,
      "type": "array",
